{
  "manifest_version": 3,
  "name": "导入 DeepSeek 到 PCAR",
  "version": "0.1.0",
  "description": "将已下载的官方 DeepSeek 导出包交给本机 PCAR，打开所选窗口的建卡预览。",
  "key": "",
  "permissions": [
    "activeTab",
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
